# Copy to .env (never commit .env). Docker Compose passes these to every Python service.
# With no AI key at all, Ecstasy runs in a clearly labelled local fallback mode.

# --- AI provider ---
# auto: Groq when GROQ_API_KEY is set, else AWS Bedrock when AWS credentials are set | groq | bedrock
NIMBUS_LLM_PROVIDER=auto

# --- Groq (free tier available: console.groq.com > API Keys) ---
GROQ_API_KEY=
# Answers and listing drafts / query planner and report extraction / document embeddings
GROQ_LLM_MODEL_ID=openai/gpt-oss-120b
GROQ_FAST_LLM_MODEL_ID=openai/gpt-oss-20b
GROQ_EMBED_MODEL_ID=nomic-embed-text-v1_5
# low | medium | high (gpt-oss models only; low keeps answers fast and inside free-tier token limits)
GROQ_REASONING_EFFORT=low
# Longest Retry-After a request will wait out on HTTP 429 before falling back to the rule-based answer
GROQ_MAX_RETRY_WAIT_S=30

# --- AWS credentials (boto3 reads these from the environment) ---
# Option A: a Bedrock API key (Bedrock console > API keys). Covers Titan and Claude; Rerank then
# falls back to local ranking because the Rerank API needs IAM keys.
AWS_BEARER_TOKEN_BEDROCK=
# Option B: IAM user access keys (covers everything, including Rerank).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (STS / SSO) credentials:
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# --- Bedrock models (your account must have model access enabled in this region) ---
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIM=1024
# Use an inference-profile id (us./eu./apac. prefix) if on-demand access needs one.
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_FAST_LLM_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Amazon Rerank (amazon.rerank-v1:0) or Cohere (cohere.rerank-v3-5:0). Rerank is offered in fewer
# regions, e.g. us-west-2; leave the region empty to use AWS_REGION.
BEDROCK_RERANK_MODEL_ID=amazon.rerank-v1:0
BEDROCK_RERANK_REGION=us-west-2
BEDROCK_RERANK_ENABLED=true
BEDROCK_EMBED_WORKERS=4

# --- Behaviour ---
# auto: the AI provider when its credentials work, else local fallback | local: never call any AI API
NIMBUS_AI_MODE=auto
# Override the venue time zone from venue.json (IANA name), e.g. Europe/London
NIMBUS_VENUE_TZ=
