# API image for the Vercel "api" service. Build context: repo root (service root "." in vercel.json).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=80

WORKDIR /app

COPY services/requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

COPY packages/nimbus_core /opt/nimbus_core
RUN pip install /opt/nimbus_core

COPY services/api /app/services/api
WORKDIR /app/services/api

# Vercel routes traffic to $PORT and passes the original /api/... path through unchanged.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port \"${PORT}\" --proxy-headers --forwarded-allow-ips='*'"]
